{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bjrobust",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"SITE_DEFAULT": "bjrobust"
	},
	"routes": [
		{ "pattern": "bjrobust.qlxtools.asia", "custom_domain": true },
		{ "pattern": "aaaa.qlxtools.asia", "custom_domain": true },
		{ "pattern": "bbbb.qlxtools.asia", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"run_worker_first": ["/", "/index.html"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bjrobust",
			"database_id": "d2e1886b-2684-4774-b97d-6925446b5b3b"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "bjrobust"
		}
	]
}
